NEXT_PUBLIC_SUPABASE_URL=your-supabase-project-url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Vercel Blob storage (required for direct browser uploads)
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_your-store-token

# Inngest background jobs
INNGEST_EVENT_KEY=your-inngest-event-key
INNGEST_SIGNING_KEY=signkey-your-inngest-signing-key
# INNGEST_DEV=1

# Free AI provider fallback stack
GROQ_API_KEY=your-groq-api-key
GEMINI_API_KEY=your-gemini-api-key
OPENROUTER_API_KEY=your-openrouter-api-key

# Optional: only used by AI voiceover and MCP tools
# OPENAI_API_KEY=your-openai-api-key

# Encrypts OAuth access and refresh tokens at rest (32-byte base64 recommended).
TOKEN_ENCRYPTION_KEY=your-token-encryption-key

# TikTok developer app
TIKTOK_CLIENT_KEY=your-tiktok-client-key
TIKTOK_CLIENT_SECRET=your-tiktok-client-secret
TIKTOK_PRIVACY_LEVEL=SELF_ONLY

# Google Cloud OAuth client with YouTube Data API v3 enabled
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
YOUTUBE_PRIVACY_STATUS=private

# Optional extra secret for manually triggering the publishing cron
CRON_SECRET=your-cron-secret

# Paystack subscriptions
PAYSTACK_SECRET_KEY=sk_test_your-paystack-secret-key
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=pk_test_your-paystack-public-key

NEXT_PUBLIC_SITE_URL=http://localhost:3000
