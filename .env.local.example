NEXT_PUBLIC_SUPABASE_URL=your-supabase-project-url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

OPENAI_API_KEY=your-openai-api-key

# Encrypts OAuth access and refresh tokens at rest (32-byte base64 recommended).
TOKEN_ENCRYPTION_KEY=your-token-encryption-key

# TikTok developer app
TIKTOK_CLIENT_KEY=your-tiktok-client-key
TIKTOK_CLIENT_SECRET=your-tiktok-client-secret
TIKTOK_PRIVACY_LEVEL=SELF_ONLY

# Google Cloud OAuth client with YouTube Data API v3 enabled
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
YOUTUBE_PRIVACY_STATUS=private

# Optional extra secret for manually triggering the publishing cron
CRON_SECRET=your-cron-secret

# Stripe subscriptions
STRIPE_SECRET_KEY=sk_test_your-stripe-secret-key
STRIPE_WEBHOOK_SECRET=whsec_your-webhook-signing-secret
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your-stripe-publishable-key
STRIPE_PRICE_PRO=price_your-pro-price-id
STRIPE_PRICE_AGENCY=price_your-agency-price-id

NEXT_PUBLIC_SITE_URL=http://localhost:3000
